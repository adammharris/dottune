// The web player, served from dist/ as Workers static assets at
// adammharris.com/dottune/. The build writes into dist/dottune/ so asset
// paths match the URL path; the rest of adammharris.com is untouched.
// Build first (`bun run build`), then `bun run deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dottune",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "adammharris.com/dottune", "zone_name": "adammharris.com" },
    { "pattern": "adammharris.com/dottune/*", "zone_name": "adammharris.com" }
  ],
  "workers_dev": false,
  "preview_urls": false
}
